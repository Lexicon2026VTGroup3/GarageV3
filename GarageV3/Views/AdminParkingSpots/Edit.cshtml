@model GarageV3.ViewModels.AdminParkingSpotViewModel

@{
    ViewData["Title"] = "Edit Parking Spot";
}

<div class="container">
    <div class="col-md-8 mx-auto">
        <a asp-action="Index" class="sv-back-link small">&larr; Back to Parking Spots</a>

        <div class="garage-header">
            <h3>Edit Parking Spot</h3>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-12">
                <div class="card sv-card mt-3">
                    <div class="sv-flag-bar"></div>

                    <div class="card-body p-4">
                        <form asp-action="Edit">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <input type="hidden" asp-for="Id" />

                            <div class="form-group mb-3">
                                <label asp-for="Number" class="control-label"></label>
                                <input asp-for="Number" class="form-control" type="number" min="1" />
                                <span asp-validation-for="Number" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Location" class="control-label"></label>
                                <input asp-for="Location" class="form-control" />
                                <span asp-validation-for="Location" class="text-danger"></span>
                            </div>

                            <div class="form-check mb-4">
                                <input asp-for="IsOutOfService" class="form-check-input" type="checkbox" />
                                <label asp-for="IsOutOfService" class="form-check-label">
                                    Out of Service (Ur funktion)
                                </label>
                                <span asp-validation-for="IsOutOfService" class="text-danger"></span>
                            </div>

                            <div class="form-group mt-4 d-flex gap-4">
                                <button type="submit" class="btn garage-btn w-50">Save</button>
                                <a asp-action="Index" class="btn btn-secondary w-50">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}