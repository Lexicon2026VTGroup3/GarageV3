@model GarageV3.ViewModels.UserManagement.ManageUserRolesViewModel

@{
    ViewData["Title"] = "Manage Roles";
}

<div class="container">
    <div class="col-md-6 mx-auto">
        <div class="garage-header">
            <h3>Manage Roles for @Model.UserName</h3>
        </div>

		<form asp-action="EditRoles" method="post" class="mt-3">
			<div asp-validation-summary="All" class="text-danger"></div>
			<input type="hidden" asp-for="UserId" />
			<input type="hidden" asp-for="UserName" />

			<div class="card mb-3">
				<div class="card-body">
					@for (int i = 0; i < Model.Roles.Count; i++)
					{
						<div class="form-check my-2">
							<input type="hidden" asp-for="Roles[i].RoleName" />
							<input type="checkbox" asp-for="Roles[i].IsSelected" class="form-check-input" />
							<label class="form-check-label" asp-for="Roles[i].IsSelected">
								@Model.Roles[i].RoleName
							</label>
						</div>
					}
				</div>
			</div>

			<button type="submit" class="btn garage-btn">Save Changes</button>
			<a asp-action="Index" class="btn btn-secondary">Cancel</a>
		</form>
    </div>
</div>

