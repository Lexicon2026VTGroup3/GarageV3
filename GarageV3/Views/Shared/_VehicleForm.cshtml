@using GarageV3.Helpers

@model GarageV3.ViewModels.ParkedVehicleFormViewModel

@Html.HiddenFor(m => m.Id)
@Html.HiddenFor(m => m.ArrivalTime)
@Html.HiddenFor(m => m.AssignedSpotNumber)

<div class="form-group mb-3">
    <label asp-for="RegistrationNumber" class="control-label"></label>
    <input asp-for="RegistrationNumber" class="form-control" />
    <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="VehicleType" class="control-label"></label>

    @if (Model.Id.HasValue)
    {
        <select asp-for="VehicleType" 
            asp-items="VehicleTypeHelper.GetValidVehicleTypes(Model.VehicleType)" 
            class="form-select"
        ></select>
    }
    else
    {
        <select asp-for="VehicleType" asp-items="Model.VehicleTypes" class="form-select"></select>
    }

    <span asp-validation-for="VehicleType" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="Color" class="control-label"></label>
    <input asp-for="Color" class="form-control" />
    <span asp-validation-for="Color" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="Brand" class="control-label"></label>
    <input asp-for="Brand" class="form-control" />
    <span asp-validation-for="Brand" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="Model" class="control-label"></label>
    <input asp-for="Model" class="form-control" />
    <span asp-validation-for="Model" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="NumberOfWheels" class="control-label"></label>
    <input asp-for="NumberOfWheels" class="form-control" min="0" max="18" placeholder="ex. 4" />
    <span asp-validation-for="NumberOfWheels" class="text-danger"></span>
</div>