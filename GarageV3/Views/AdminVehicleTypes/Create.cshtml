@model GarageV3.ViewModels.AdminVehicleTypeViewModel

@{
    ViewData["Title"] = "Register Vehicle Type";
}

<div class="container">
    <div class="col-md-8 mx-auto">
        <a asp-action="Index" class="sv-back-link small">&larr; Back to Vehicle Types</a>

        <div class="garage-header">
            <h3>Register New Vehicle Type</h3>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-12">
                <div class="card sv-card mt-3">
                    <div class="sv-flag-bar"></div>

                    <div class="card-body p-4">
                        <form asp-action="Create">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <div class="form-group mb-3">
                                <label asp-for="Name" class="control-label"></label>
                                <input asp-for="Name" class="form-control" placeholder="e.g. Car, Motorcycle..." />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="ShortName" class="control-label"></label>
                                <input asp-for="ShortName" class="form-control" placeholder="e.g. CAR, MC..." />
                                <span asp-validation-for="ShortName" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Icon" class="control-label"></label>
                                <input asp-for="Icon" class="form-control" placeholder="e.g. bi-car-front" />
                                <span asp-validation-for="Icon" class="text-danger"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6 form-group mb-3">
                                    <label asp-for="BadgeColor" class="control-label"></label>
                                    <input asp-for="BadgeColor" type="color" class="form-control form-control-color w-100" />
                                    <span asp-validation-for="BadgeColor" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 form-group mb-3">
                                    <label asp-for="BadgeTextColor" class="control-label"></label>
                                    <input asp-for="BadgeTextColor" type="color" class="form-control form-control-color w-100" />
                                    <span asp-validation-for="BadgeTextColor" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 form-group mb-3">
                                    <label asp-for="RequiredSpots" class="control-label"></label>
                                    <input asp-for="RequiredSpots" class="form-control" type="number" min="1" />
                                    <span asp-validation-for="RequiredSpots" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 form-group mb-3">
                                    <label asp-for="MaxVehiclesPerSpot" class="control-label"></label>
                                    <input asp-for="MaxVehiclesPerSpot" class="form-control" type="number" min="1" />
                                    <span asp-validation-for="MaxVehiclesPerSpot" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-group mt-4 d-flex gap-4">
                                <button type="submit" class="btn garage-btn w-50">Register</button>
                                <a asp-action="Index" class="btn btn-secondary w-50">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}