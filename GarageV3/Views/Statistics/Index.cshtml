@model GarageV3.ViewModels.GarageStatisticsViewModel

@{
    ViewData["Title"] = "Garage Statistics";
}

<div class="container mt-4">
    <a asp-controller="ParkedVehicles" asp-action="Index" class="sv-back-link small">&larr; Back to overview</a>

    <div class="garage-header">
        <h3>Garage Statistics</h3>
    </div>

    <div class="row mt-4 g-3">
        <div class="col-md-4">
            <div class="card sv-card p-3 text-center">
                <div class="sv-label">Free Spots</div>
                <div class="fs-3 fw-bold">@Model.FreeSpots</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card sv-card p-3 text-center">
                <div class="sv-label">Occupied Spots</div>
                <div class="fs-3 fw-bold">@Model.OccupiedSpots</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card sv-card p-3 text-center">
                <div class="sv-label">Out of Service</div>
                <div class="fs-3 fw-bold">@Model.OutOfServiceSpots</div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            <h5 class="sv-header">Active Vehicles by Type</h5>

            @if (!Model.ActiveVehiclesByType.Any())
            {
                <p>No active vehicles right now.</p>
            }
            else
            {
                <table class="table sv-table">
                    <thead>
                        <tr>
                            <th>Vehicle Type</th>
                            <th class="text-end">Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ActiveVehiclesByType)
                        {
                            <tr>
                                <td>@item.TypeName</td>
                                <td class="text-end">@item.Count</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>