@using GarageV3.Helpers

@model GarageV3.Models.Entities.Vehicle

@{
    ViewData["Title"] = "Delete Vehicle";

    var vehicleType = Model.VehicleTypeRef!.EnumValue;
    var badgeColor = VehicleTypeHelper.GetBadgeColor(vehicleType);
    var badgeTextColor = VehicleTypeHelper.GetBadgeTextColor(vehicleType);
}

<div class="container">
    <div class="col-md-8 mx-auto">
        <a asp-action="Index" class="sv-back-link small">&larr; Back to My Vehicles</a>

        <div class="garage-header">
            <h3>Delete Vehicle</h3>
            <h4 class="text-danger">Are you sure you want to delete this vehicle?</h4>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-12">
                <div class="card sv-card mt-3">
                    <div class="sv-flag-bar"></div>

                    <div class="card-body p-4">
                        <div class="mb-3">
                            <h4 class="m-2 mt-0">@Model.RegistrationNumber</h4>
                            <span class="sv-badge" style="background-color:@badgeColor; color:@badgeTextColor;">
                                @vehicleType.GetDisplayName()
                            </span>
                        </div>

                        <dl class="row mb-0 gy-2">
                            <dt class="col-5 sv-label">Color</dt>
                            <dd class="col-7 mb-0">@(string.IsNullOrEmpty(Model.Color) ? "-" : Model.Color)</dd>

                            <dt class="col-5 sv-label">Brand</dt>
                            <dd class="col-7 mb-0">@(string.IsNullOrEmpty(Model.Brand) ? "-" : Model.Brand)</dd>

                            <dt class="col-5 sv-label">Model</dt>
                            <dd class="col-7 mb-0">@(string.IsNullOrEmpty(Model.Model) ? "-" : Model.Model)</dd>

                            <dt class="col-5 sv-label">Wheels</dt>
                            <dd class="col-7 mb-0">@Model.NumberOfWheels</dd>

                            <dt class="col-5 sv-label">Registered Time</dt>
                            <dd class="col-7 mb-0">@Model.ArrivalTime.ToString("yyyy-MM-dd HH:mm")</dd>
                        </dl>

                        <form asp-action="Delete">
                            <input type="hidden" asp-for="Id" />

                            <div class="mt-4 d-flex gap-4">
                                <button type="submit" class="btn btn-danger w-50">Delete</button>
                                <a asp-action="Index" class="btn btn-secondary w-50">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>