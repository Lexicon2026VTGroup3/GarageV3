@using GarageV3.Helpers

@model GarageV3.Models.Entities.Vehicle

@{
    ViewData["Title"] = "Vehicle Details";

    var typeName = Model.VehicleTypeRef != null ? (Model.VehicleTypeRef.Icon + " " + Model.VehicleTypeRef.Name) : "Unknown";
	var bageColor = Model.VehicleTypeRef != null ? Model.VehicleTypeRef.BadgeColor : "#6c757d"; // Default to gray
	var badgeTextColor = Model.VehicleTypeRef != null ? Model.VehicleTypeRef.BadgeTextColor : "#ffffff"; // Default to white
}

<div class="container">
    <div class="col-md-8 mx-auto">
        <div class="garage-header">
            <h3>Vehicle Details</h3>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-12">
                <div class="card sv-card mt-3">
                    <div class="sv-flag-bar"></div>

                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h4 class="m-2 mt-0">@Model.RegistrationNumber</h4>
                                <span class="sv-badge" style="background-color:@bageColor; color:@badgeTextColor;">
                                    @typeName
                                </span>
                            </div>
                        </div>

                        <hr class="my-3" />

                        <dl class="row mb-0 gy-2">
                            <dt class="col-5 sv-label">Color</dt>
                            <dd class="col-7 mb-0">@(string.IsNullOrEmpty(Model.Color) ? "-" : Model.Color)</dd>

                            <dt class="col-5 sv-label">Brand</dt>
                            <dd class="col-7 mb-0">@(string.IsNullOrEmpty(Model.Brand) ? "-" : Model.Brand)</dd>

                            <dt class="col-5 sv-label">Model</dt>
                            <dd class="col-7 mb-0">@(string.IsNullOrEmpty(Model.Model) ? "-" : Model.Model)</dd>

                            <dt class="col-5 sv-label">Wheels</dt>
                            <dd class="col-7 mb-0">@Model.NumberOfWheels</dd>

                            <dt class="col-5 sv-label">Assigned Spot</dt>
                            <dd class="col-7 mb-0">@SpotHelper.GetSpotDisplay(Model.AssignedSpotNumber, (Model.VehicleTypeRef?.RequiredSpots ?? 1))</dd>

                            <dt class="col-5 sv-label">Registered Time</dt>
                            <dd class="col-7 mb-0">@Model.ArrivalTime.ToString("yyyy-MM-dd HH:mm")</dd>
                        </dl>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="sv-back-link">
                                &larr; Back
                            </a>

                            <a asp-action="Edit" asp-route-id="@Model?.Id" class="sv-back-link">
                                Edit &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>