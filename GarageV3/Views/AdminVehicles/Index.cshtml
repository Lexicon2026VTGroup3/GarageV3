@using GarageV3.Helpers

@model List<AdminVehiclesIndexViewModel>

@{
    ViewData["Title"] = "All User Vehicle Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 gap-3">
        <h2>Manage All Vehicles</h2>

        <a asp-action="Create" class="btn sv-btn-create d-flex align-items-center">
            Register New Vehicle
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="searchQuery" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search by owner email..." />
            <button type="submit" class="btn btn-outline-primary">Search</button>
            @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            }
        </div>
    </form>



    @if (!Model.Any())
    {
        <div class="alert alert-info text-center mt-4" role="alert">
            No vehicles registered in the system yet.
        </div>
    }
    else
    {
        <div class="mb-3 text-muted">
            <strong>@Model.Count()</strong> @(Model.Count() == 1 ? "vehicle registered." : "vehicles registered.")
        </div>

        <div class="table-responsive">
            <table class="table table-hover sv-table align-middle">
                <thead>
                    <tr>
                        <th>Owner Email</th>
                        <th>Vehicle Type</th>
                        <th>Registration Number</th>
                        <th>Brand / Model</th>
                        <th>Color</th>
                        <th>Parking Spot</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="text-muted">@item.OwnerEmail</span></td>
                            <td>@item.DisplayVehicleType</td>
                            <td><strong>@item.RegistrationNumber</strong></td>
                            <td>@item.Brand @item.Model</td>
                            <td>@item.Color</td>
                            <td>@SpotHelper.GetSpotDisplay(item.ParkingSpotId, item.RequiredSpots)</td>
                            <td class="text-end">
                                @if (!item.ParkingSpotId.HasValue)
                                {
                                    <a asp-controller="Parking" asp-action="Park" asp-route-id="@item.Id" class="btn btn-success sv-action-btn w-sm-auto">Park</a>
                                }
                                else
                                {
                                    <a asp-controller="Parking" asp-action="CheckOut" asp-route-id="@item.ActiveParkingSessionId" class="btn btn-warning sv-action-btn w-sm-auto">Check Out</a>
                                }
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn sv-btn-details sv-action-btn w-sm-auto">Details</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn sv-btn-details sv-action-btn w-sm-auto">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger sv-action-btn w-sm-auto">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>