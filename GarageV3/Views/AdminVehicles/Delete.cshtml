@model GarageV3.Models.Entities.Vehicle

@{
    ViewData["Title"] = "Delete Vehicle";
}

<div class="container mt-5">
    <div class="col-md-6 mx-auto">
        <h3>Are you sure you want to delete this vehicle?</h3>
        <hr />
        <div class="card p-4">
            <dl class="row">
                <dt class="col-sm-4">Registration Number</dt>
                <dd class="col-sm-8">@Model.RegistrationNumber</dd>

                <dt class="col-sm-4">Owner Email</dt>
                <dd class="col-sm-8">@Model.Owner?.Email</dd>
            </dl>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger w-50">Delete</button>
                    <a asp-action="Index" class="btn btn-secondary w-50">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>