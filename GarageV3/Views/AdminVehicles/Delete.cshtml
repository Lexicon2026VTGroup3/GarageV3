@model GarageV3.ViewModels.AdminVehiclesIndexViewModel
@{
    ViewData["Title"] = "Delete Vehicle";
}

<div class="container">
    <div class="col-md-8 mx-auto">
        <div class="garage-header">
            <h3>Delete Vehicle (Admin)</h3>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-12">
                <div class="card sv-card mt-3">
                    <div class="sv-flag-bar"></div>

                    <div class="card-body p-4">
                        @await Html.PartialAsync("_VehicleDetailsPartial", Model)

                        <hr />

                        <form asp-action="Delete">
                            <input type="hidden" asp-for="Id" />

                            <h5 class="text-danger text-center mb-4">Are you sure you want to delete this vehicle?</h5>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-danger w-50">Delete</button>
                                <a asp-action="Index" class="btn btn-secondary w-50">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>