@model GarageV3.ViewModels.AdminVehicleCreateViewModel

@{
    ViewData["Title"] = "Update Vehicle";
}

<div class="container">
    <div class="col-md-8 mx-auto">
        <div class="garage-header">
            <h3>Update Vehicle Information</h3>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-12">
                <div class="card sv-card mt-3">
                    <div class="sv-flag-bar"></div>

                    <div class="card-body p-4">
                        <form asp-action="Edit">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            
                            <input type="hidden" asp-for="Id" />
                            @if (Model.IsParked)
                            {
                                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                                    <strong>⚠️ Warning:</strong> This vehicle is currently parked in the garage. Modify details with caution!
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            }
                            <div class="form-group mb-3">
                                <label asp-for="OwnerId" class="control-label fw-bold">Vehicle Owner</label>
                                <select asp-for="OwnerId" class="form-control" asp-items="Model.Users">
                                    <option value="">-- Select Owner --</option>
                                </select>
                                <span asp-validation-for="OwnerId" class="text-danger"></span>
                            </div>

                            <partial name="_VehicleForm" model="Model" />

                            <div class="form-group mt-4 d-flex gap-4">
                                <button type="submit" class="btn garage-btn w-50">Save Changes</button>
                                <a asp-action="Index" class="btn btn-secondary w-50">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}