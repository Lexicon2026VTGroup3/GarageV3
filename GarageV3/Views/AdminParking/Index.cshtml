@model List<GarageV3.ViewModels.ActiveParkingOverviewViewModel>

@{
    ViewData["Title"] = "Active Parking";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Active Parking</h2>
    </div>

    <!-- Search and filter -->
    <form asp-action="Index" method="get" class="mb-4">
        <div class="row g-2">

            <!-- Registration number search -->
            <div class="col-md-5">
                <label for="registrationSearch" class="form-label">
                    Registration Number
                </label>

                <input type="text"
                       id="registrationSearch"
                       name="registrationSearch"
                       value="@ViewData["CurrentRegistrationSearch"]"
                       class="form-control"
                       placeholder="Search registration number..." />
            </div>

            <!-- Vehicle type filter -->
            <div class="col-md-4">
                <label for="vehicleType" class="form-label">
                    Vehicle Type
                </label>

                <select id="vehicleType"
                        name="vehicleType"
                        class="form-select">

                    <option value="">All vehicle types</option>

                    @foreach (var type in (string[])ViewData["VehicleTypes"]!)
                    {
                        if (type == ViewData["CurrentVehicleType"]?.ToString())
                        {
                            <option value="@type" selected>@type</option>
                        }
                        else
                        {
                            <option value="@type">@type</option>
                        }
                    }
                </select>
            </div>

            <!-- Buttons -->
            <div class="col-md-3 d-flex align-items-end gap-2">

                <button type="submit"
                        class="btn btn-outline-primary">
                    Search
                </button>

                @if (!string.IsNullOrWhiteSpace(ViewData["CurrentRegistrationSearch"]?.ToString())
                    || !string.IsNullOrWhiteSpace(ViewData["CurrentVehicleType"]?.ToString()))
                {
                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Reset
                    </a>
                }

            </div>

        </div>
    </form>

    <!-- Active parking results -->
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover sv-table align-middle">

                <thead>
                    <tr>
                        <th>Owner</th>
                        <th>Vehicle Type</th>
                        <th>Registration Number</th>
                        <th>Parking Spot</th>
                        <th>Location</th>
                        <th>Check-in Time</th>
                        <th>Parking Duration</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @item.OwnerName
                            </td>

                            <td>
                                @item.VehicleTypeName
                            </td>

                            <td>
                                <strong>@item.RegistrationNumber</strong>
                            </td>

                            <td>
                                #@item.ParkingSpotNumber
                            </td>

                            <td>
                                @item.Location
                            </td>

                            <td>
                                @item.CheckInTime.ToString("yyyy-MM-dd HH:mm")
                            </td>

                            <td>
                                @{
                                    var duration =
                                        TimeSpan.FromMinutes(item.ParkingDurationMinutes);
                                }

                                @($"{(int)duration.TotalDays} d {duration.Hours} h {duration.Minutes} m")
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            No active parking matches your search criteria.
        </div>
    }

</div>