@using GarageV3.Helpers

@model IEnumerable<GarageV3.ViewModels.Parking.ParkingHistoryViewModel>

@{
    ViewData["Title"] = "My Parking History";
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="successAlert" class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex justify-content-between align-items-center" role="alert">
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close position-relative p-0" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container mt-4">

    @if (!Model.Any())
    {
        @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string) || !string.IsNullOrEmpty(ViewData["CurrentTimeFilter"] as string))
        {
            var searchFilterText = string.Join(" / ", 
                new[] { ViewData["CurrentFilter"] as string, ViewData["CurrentTimeFilter"] as string }
                .Where(s => !string.IsNullOrEmpty(s)));

            <div class="alert alert-warning text-center mt-4" role="alert">
                No parking records found matching <strong>"@searchFilterText"</strong>.
            </div>
        }
        else
        {
            <div class="alert alert-info text-center mt-4" role="alert">
                No parking history found.
            </div>
        }
    }
    else
    {
        <div class="mb-3 text-muted">
            <strong>@Model.Count()</strong> @(Model.Count() == 1 ? "parking record found." : "parking records found.")
        </div>

        <div class="table-responsive">
            <table class="table table-hover sv-table align-middle">
                <thead>
                    <tr>
                        <th>
                            <a asp-action="History"
                               class="sv-nav-link">
                                Vehicle Type
                            </a>
                        </th>
                        <th>
                            <a asp-action="History"
                               class="sv-nav-link">
                                Registration Number
                            </a>
                        </th>
                        <th>
                            <a asp-action="History"
                               class="sv-nav-link">
                                Parking Spot
                            </a>
                        </th>
                        <th>
                            <a asp-action="History"
                               class="sv-nav-link">
                                Arrival Time
                                <span>▼</span>
                            </a>
                        </th>
                        <th>
                            <a asp-action="History"
                               class="sv-nav-link">
                                Parked Duration
                            </a>
                        </th>
                        <th>
                            <a asp-action="History"
                               class="sv-nav-link">
                                Hourly Rate
                            </a>
                        </th>
                        <th>
                            <a asp-action="History"
                               class="sv-nav-link">
                                Total Price
                            </a>
                        </th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span>@Html.DisplayFor(modelItem => item.VehicleTypeDisplay)</span></td>
                            <td><strong>@Html.DisplayFor(modelItem => item.RegistrationNumber)</strong></td>
                            <td>@SpotHelper.GetSpotDisplay(item.ParkingSpotId, item.RequiredSpots)</td>
                            <td class="local-time-display" data-utc='@item.ArrivalTime.ToString("o")'>
                                @item.ArrivalTime.ToString("ddd, dd MMM yyyy, HH:mm")
                            </td>
                            <td>@item.ParkedDuration.ToString(@"dd\.hh\:mm")</td>
							<td>@item.HourlyRateAtCheckIn.ToString("C")</td>
                            <td>@item.TotalPrice.ToString("C")</td>
                            <td class="text-end">
                                <a asp-action="PrintReceipt" asp-route-id="@item.SessionId" class="btn sv-btn-details sv-action-btn w-sm-auto">Print</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        fadeOutSuccessAlert();
    </script>
}